---
import { Section } from "@/components/index";
import BrainIcon from "@/features/skills/assets/icons/brain.svg";
import SkillCategoryContainer from "@/features/skills/components/SkillCategoryContainer.astro";
import { skillCategories } from "@/features/skills/data/skillCategories";
---

<Section id="skills" title="Skills" Icon={BrainIcon}>
  <div class="gap-4 grid md:grid-cols-2 px-4">
    {
      skillCategories.map((category) => (
        <SkillCategoryContainer {...category} />
      ))
    }
  </div>
</Section>
