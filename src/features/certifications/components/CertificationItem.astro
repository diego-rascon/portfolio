---
import { ListItem, StyledLink } from "@/components/index";
import type { Certification } from "@/features/certifications/types/Certification";
import { resolveImagePath } from "@/utils/index";

interface Props {
  certificationItem: Certification;
}

const {
  certificationItem: { url, title, description, image, alt },
} = Astro.props;
---

<ListItem image={resolveImagePath("certifications", image)} alt={alt}>
  <div class="flex items-center">
    <StyledLink url={url}>{title}</StyledLink>
  </div>
  <p class="font-light text-slate-400">{description}</p>
</ListItem>
