---
import GlowWrapper from "@/components/GlowWrapper.svelte";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Diego Rascón — Full-Stack Engineer",
  description = "Full-Stack Engineer focused on modern web and mobile development. I bridge the gap between elegant client-side experiences and high-performance server architectures.",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImageURL = Astro.site ? new URL("/images/og-image.png", Astro.site) : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Diego Rascón" />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diego Rascón" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL.href} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diego Rascón — Full-Stack Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL.href} />}
  </head>
  <body class="bg-grid-pattern bg-slate-900 font-[Lexend] antialiased">
    <GlowWrapper client:media="(min-width: 768px)" />
    <slot />
  </body>
</html>
