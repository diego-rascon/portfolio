---
import { GlassContainer } from "@/components/index";

interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
---

<li>
  <GlassContainer>
    <div class="group flex md:flex-row flex-col gap-4">
      <img
        fetchpriority="high"
        src={image}
        alt={alt}
        class="h-56 md:h-36 w-full md:max-w-56 object-cover border border-slate-600 rounded-lg transition-all"
      />
      <div class="flex flex-col justify-center gap-2">
        <slot />
      </div>
    </div>
  </GlassContainer>
</li>
